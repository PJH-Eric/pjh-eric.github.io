{
  "name": "pjh-games-all-in-one",
  "version": "0.1.0",
  "private": true,
  "description": "遊戲小小島 all-in-one：17 款遊戲＋大廳的單一 monorepo（共用前端套件、共用伺服器）",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "baseline": "node scripts/baseline.js",
    "sync": "node scripts/sync-shared.js --write",
    "check:sync": "node scripts/sync-shared.js",
    "check:originals": "node scripts/check-originals.js",
    "start": "tsx apps/game-server/server.js",
    "test:server": "tsx apps/game-server/tests/smoke.js",
    "build": "node scripts/build-all.js",
    "build:vite": "node scripts/build-all.js --vite",
    "verify": "node scripts/verify-games.js",
    "verify:browser": "node scripts/verify-games.js --browser",
    "start:local": "tsx apps/game-server/server.js"
  },
  "engines": {
    "node": "^26.12.1"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
